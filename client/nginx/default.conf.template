server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Тот же origin, что и у приложения: CORS в браузере не нужен.
    location /users {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Бандл пересобирается без хешей в именах, поэтому кэш браузера
    # отдаёт старую версию. Точки входа и код запрещаем кэшировать.
    location = /index.html {
        add_header Cache-Control "no-store";
    }
    location = /flutter_bootstrap.js {
        add_header Cache-Control "no-store";
    }
    location = /flutter_service_worker.js {
        add_header Cache-Control "no-store";
    }
    location ~* \.(?:js|mjs|wasm|json)$ {
        add_header Cache-Control "no-cache";
    }

    # Flutter web: любой путь отдаёт index.html (клиентская навигация).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
